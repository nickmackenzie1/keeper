# Copy to .env (next to docker-compose.yml) and fill in.

# The access code both phones enter once. Make one with:  openssl rand -hex 16
KEEPER_API_TOKEN=

# TMDB "API Read Access Token" — free at https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=

# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → "Install connector" (the long token)
CLOUDFLARE_TUNNEL_TOKEN=

# Contact address the push services can reach if something's wrong (any email of yours)
VAPID_SUBJECT=mailto:you@example.com

# Shelf scan (AI reads DVD spines from a photo). From console.anthropic.com → API Keys.
# Set a monthly spend limit there (Billing). Leave blank to turn shelf scan off.
ANTHROPIC_API_KEY=

# --- Optional ---

# Model for shelf scan, and a daily cap on shelf photos (both phones combined).
ANTHROPIC_MODEL=claude-sonnet-5-5
SHELF_DAILY_LIMIT=40

# UPCitemdb paid key. Blank = free trial (~100 barcode lookups/day, each barcode cached forever).
UPCITEMDB_KEY=

# A phone that hasn't synced in this many days gets a full fresh copy.
FULL_RESYNC_DAYS=14

# Background-update notifications: wait this long after changes, and send at most one per N hours.
PUSH_DEBOUNCE_MINUTES=10
PUSH_MIN_HOURS=12

# Deleted items are remembered this long so the other phone learns about them, then purged.
TOMBSTONE_DAYS=60
